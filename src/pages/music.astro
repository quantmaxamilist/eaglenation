---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { music } from '../data/site';
---
<Base
  title={music.title}
  description="Eagle Nation Music: recording, singing, dance and songwriting projects for children and young people in Coventry, built to inspire connection and creativity."
  image="/images/stock/music-producer-studio.jpg"
>
  <PageHero
    eyebrow="Recording · Singing · Dance · Songwriting"
    title={music.heading}
    lead={music.intro[0]}
    image="/images/stock/music-singer-stage.jpg"
    imageAlt="A singer performing under green and yellow stage lights"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Music' }]}
  />

  <section class="section projects">
    <div class="container">
      <div class="projects__head">
        <div>
          <p class="eyebrow" data-reveal>Projects</p>
          <h2 data-reveal style="--d:.05s">{music.projectsLead.replace(':', '')}</h2>
        </div>
        <p class="intro__big" data-reveal style="--d:.1s">{music.intro[1]}</p>
      </div>
      <ol class="projects__grid" role="list">
        {music.projects.map((p, i) => (
          <li class="proj" data-reveal style={`--d:${i * 0.07}s`}>
            <div class="photo proj__img"><img src={p.image} alt={p.alt} width="1200" height="800" loading="lazy" /></div>
            <div class="proj__label">
              <span class="proj__num">0{i + 1}</span>
              <h3>{p.name}</h3>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--paper-2 testimonial">
    <div class="container testimonial__grid">
      <div class="photo testimonial__img" data-reveal>
        <img src={music.testimonial.image} alt={music.testimonial.name} width="632" height="1080" loading="lazy" />
      </div>
      <figure class="testimonial__body" data-reveal style="--d:.08s">
        <p class="eyebrow">{music.testimonial.label}</p>
        <blockquote>
          <p>“{music.testimonial.quote}”</p>
        </blockquote>
        <figcaption><span class="testimonial__name">{music.testimonial.name}</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="label on-dark">
    <div class="container label__grid">
      <div class="label__img" data-reveal>
        <img src={music.label.image} alt="Eagle Nation Music label artwork" width="1080" height="1080" loading="lazy" />
      </div>
      <div data-reveal style="--d:.08s">
        <p class="eyebrow">{music.label.kicker.replace('.', '')}</p>
        <h2>{music.label.heading}</h2>
        <p class="label__text">{music.label.text}</p>
      </div>
    </div>
  </section>

  <section class="section callout">
    <div class="container callout__inner" data-reveal>
      <Icon name="mic" class="callout__icon" />
      <p class="callout__text">{music.callout}</p>
      <a class="btn" href="/contact/">Get in touch <Icon name="arrow" /></a>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .intro__big { font-size: var(--step-1); line-height: 1.55; color: var(--ink-700); max-width: 48ch; }

  .projects__head { display: grid; gap: var(--sp-5); margin-bottom: var(--sp-7); align-items: end; }
  @media (min-width: 960px) { .projects__head { grid-template-columns: 1.1fr 0.9fr; gap: var(--sp-8); } }
  .projects__head h2 { margin-top: var(--sp-4); }
  .projects__grid { list-style: none; padding: 0; display: grid; gap: var(--sp-4); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .projects__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1060px) { .projects__grid { grid-template-columns: repeat(4, 1fr); } }
  .proj { position: relative; border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 3 / 4; isolation: isolate; color: var(--white); }
  .proj__img { position: absolute; inset: 0; z-index: -1; }
  .proj__img img { transition: transform 1s var(--ease); }
  .proj:hover .proj__img img { transform: scale(1.06); }
  .proj__img::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, transparent 45%, rgb(13 17 26 / 0.85)); }
  .proj__label { position: absolute; inset: auto 0 0 0; padding: var(--sp-5); display: grid; gap: 0.4rem; }
  .proj__num { font-family: var(--font-mono); font-size: 0.8rem; color: #ff8a8e; }
  .proj h3 { font-size: clamp(2rem, 1.4rem + 1.6vw, 2.75rem); }

  .testimonial__grid { display: grid; gap: var(--sp-7); align-items: center; }
  @media (min-width: 860px) { .testimonial__grid { grid-template-columns: 0.55fr 1fr; gap: var(--sp-9); } }
  .testimonial__img { border-radius: var(--radius-lg); aspect-ratio: 632 / 1080; max-width: 380px; box-shadow: var(--shadow); }
  .testimonial blockquote { margin: var(--sp-5) 0 0; }
  .testimonial blockquote p {
    font-size: var(--step-2); line-height: 1.4; font-weight: 500; color: var(--ink-800);
    position: relative;
  }
  .testimonial figcaption { margin-top: var(--sp-5); display: flex; align-items: center; gap: var(--sp-3); }
  .testimonial figcaption::before { content: ''; width: 2.5rem; height: 3px; border-radius: 2px; background: var(--brand-gradient); }
  .testimonial__name { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: var(--step-2); }

  .label { background: var(--ink-900); color: var(--paper); padding-block: var(--section-y); }
  .label__grid { display: grid; gap: var(--sp-7); align-items: center; }
  @media (min-width: 860px) { .label__grid { grid-template-columns: 0.8fr 1.2fr; gap: var(--sp-9); } }
  .label__img { border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); max-width: 480px; }
  .label h2 { margin-top: var(--sp-4); }
  .label__text { margin-top: var(--sp-5); color: var(--ink-300); font-size: var(--step-1); line-height: 1.6; max-width: 54ch; }

  .callout__inner {
    display: grid; gap: var(--sp-5); justify-items: start;
    padding: clamp(1.75rem, 1rem + 3vw, 3.5rem); border-radius: var(--radius-lg);
    background: var(--white); border: 1px solid var(--paper-3);
  }
  @media (min-width: 860px) { .callout__inner { grid-template-columns: auto 1fr auto; align-items: center; } }
  .callout :global(.callout__icon) { width: 3rem; height: 3rem; color: var(--red-600); stroke-width: 1.4; }
  .callout__text { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: var(--step-3); line-height: 1; }
</style>
