---
// The four service pages keep their original WordPress URLs:
// /coaching-and-mentoring/, /assistance-and-support/, /leisure-and-youth/,
// /education-training-and-empowering/
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { services, type Service } from '../data/site';

export function getStaticPaths() {
  return services.map((s, i) => ({ params: { service: s.slug }, props: { s, i } }));
}
const { s, i } = Astro.props as { s: Service; i: number };
const others = services.filter((o) => o.slug !== s.slug);
const [first, ...rest] = s.body;
const description = s.body[0].length > 150 ? s.body[0].slice(0, s.body[0].lastIndexOf(' ', 150)) + '…' : s.body[0];
---
<Base title={`${s.title} – Eagle Nation`} description={`${s.title} at Eagle Nation, Coventry. ${description}`} image={s.image}>
  <PageHero
    eyebrow={`Service 0${i + 1} / 0${services.length}`}
    title={s.title}
    image={s.image}
    imageAlt={s.imageAlt}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/#services' }, { label: s.title }]}
  />

  <section class="section svc-page">
    <div class="container svc-page__grid">
      <div class="svc-page__body">
        <p class="svc-page__first" data-reveal>{first}</p>
        <div class="prose">
          {rest.map((p) => <p data-reveal>{p}</p>)}
        </div>
      </div>
      <aside class="svc-page__aside" data-reveal style="--d:.08s">
        <h2 class="svc-page__aside-h">Other services</h2>
        <ul role="list">
          {others.map((o) => (
            <li>
              <a href={`/${o.slug}/`}>
                <span class="photo svc-page__thumb"><img src={o.image} alt="" width="200" height="140" loading="lazy" /></span>
                <span>{o.title}</span>
                <Icon name="arrow" />
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .svc-page__grid { display: grid; gap: var(--sp-7); }
  @media (min-width: 960px) { .svc-page__grid { grid-template-columns: 1.3fr 0.7fr; gap: var(--sp-9); align-items: start; } }
  .svc-page__first {
    font-size: var(--step-2); line-height: 1.35; font-weight: 500; color: var(--ink-900);
    padding-left: var(--sp-5); border-left: 4px solid; border-image: linear-gradient(var(--blue-600), var(--red-600)) 1;
    max-width: 40ch;
  }
  .svc-page__body .prose { margin-top: var(--sp-6); }
  .svc-page__body .prose p { color: var(--ink-700); font-size: var(--step-1); line-height: 1.6; }
  .svc-page__aside { background: var(--white); border: 1px solid var(--paper-3); border-radius: var(--radius-lg); padding: var(--sp-5); }
  @media (min-width: 960px) { .svc-page__aside { position: sticky; top: calc(var(--header-h) + 1.5rem); } }
  .svc-page__aside-h { font-family: var(--font-mono); font-weight: 500; font-size: 0.78rem; letter-spacing: 0.1em; color: var(--ink-500); margin-bottom: var(--sp-3); }
  .svc-page__aside ul { display: grid; }
  .svc-page__aside li + li { border-top: 1px solid var(--paper-3); }
  .svc-page__aside a {
    display: grid; grid-template-columns: 4.2rem 1fr auto; gap: var(--sp-4); align-items: center;
    padding: var(--sp-3) 0; text-decoration: none; color: var(--ink-900); font-weight: 700; line-height: 1.25;
  }
  .svc-page__thumb { aspect-ratio: 1; border-radius: var(--radius); }
  .svc-page__aside a :global(svg) { width: 1.1rem; height: 1.1rem; color: var(--ink-400); transition: transform 0.3s var(--ease), color 0.3s; }
  .svc-page__aside a:hover { color: var(--blue-700); }
  .svc-page__aside a:hover :global(svg) { transform: translateX(4px); color: var(--red-600); }
</style>
