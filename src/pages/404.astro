---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found – Eagle Nation" description="This page could not be found." noindex>
  <PageHero eyebrow="Error 404" title="Page not found" lead="The page you were looking for has moved or no longer exists.">
    <div style="display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem">
      <a class="btn" href="/">Back to home <Icon name="arrow" /></a>
      <a class="btn btn--ghost" href="/contact/">Contact us</a>
    </div>
  </PageHero>
</Base>
