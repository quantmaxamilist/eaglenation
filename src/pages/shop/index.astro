---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { products } from '../../data/site';
// Keep hyphenated words (t-shirt) on one line in the condensed display face.
const nb = (t: string) => t.replace(/(\S+-\S+)/g, '<span style="white-space:nowrap">$1</span>');
---
<Base
  title="Shop – Eagle Nation"
  description="Eagle Nation merchandise: oversized heavyweight hoodies and t-shirts, unisex hoodies and an aluminium water bottle, made to order."
  image="/images/shop/oversized-heavyweight-t-shirt-black-front-678e34a40cb65.jpg"
>
  <PageHero
    eyebrow={`${products.length} products · Made to order`}
    title="Shop"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Shop' }]}
  />

  <section class="section shop">
    <div class="container">
      <ul class="shop__grid" role="list">
        {products.map((p, i) => (
          <li data-reveal style={`--d:${(i % 3) * 0.06}s`}>
            <a class="card" href={`/shop/${p.slug}/`}>
              <span class="card__img">
                <img src={p.images[0].src} alt={p.images[0].alt} width="1000" height="1000" loading={i < 3 ? 'eager' : 'lazy'} />
                {p.images[1] && <img class="card__img-alt" src={p.images[1].src} alt="" width="1000" height="1000" loading="lazy" />}
              </span>
              <span class="card__body">
                <span class="card__cats">{p.categories.join(' · ')}</span>
                <span class="card__name" set:html={nb(p.name)} />
                <span class="card__sub">{p.subtitle}</span>
                <span class="card__foot">
                  <span class="card__price">{p.price}</span>
                  <span class="card__cta">Select options <Icon name="arrow" /></span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .shop__grid { list-style: none; padding: 0; display: grid; gap: var(--sp-5); grid-template-columns: 1fr; }
  @media (min-width: 600px) {
    .shop__grid { grid-template-columns: repeat(2, 1fr); }
    .shop__grid > li:last-child { grid-column: 1 / -1; }
    .shop__grid > li:last-child .card { grid-template-columns: 1fr 1fr; }
    .shop__grid > li:last-child .card__body { border-top: 0; border-left: 1px solid var(--paper-2); align-content: center; }
  }
  @media (min-width: 1000px) {
    .shop__grid { grid-template-columns: repeat(6, 1fr); }
    .shop__grid > li { grid-column: span 2; }
    .shop__grid > li:nth-child(-n + 2) { grid-column: span 3; }
    .shop__grid > li:last-child { grid-column: span 2; }
    .shop__grid > li:last-child .card { grid-template-columns: 1fr; }
    .shop__grid > li:last-child .card__body { border-left: 0; border-top: 1px solid var(--paper-2); align-content: start; }
  }
  .card {
    display: grid; height: 100%; text-decoration: none; color: var(--ink-900);
    background: var(--white); border: 1px solid var(--paper-3); border-radius: var(--radius-lg); overflow: hidden;
    transition: box-shadow 0.4s var(--ease), transform 0.4s var(--ease), border-color 0.3s;
  }
  .card:hover { box-shadow: var(--shadow); transform: translateY(-4px); border-color: transparent; }
  .card__img { position: relative; display: block; aspect-ratio: 1; background: var(--white); overflow: hidden; }
  .card__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 0.5s var(--ease), transform 0.9s var(--ease); }
  .card__img-alt { opacity: 0; }
  .card:hover .card__img-alt { opacity: 1; }
  .card:hover .card__img img { transform: scale(1.03); }
  .card__body { display: grid; gap: 0.35rem; padding: var(--sp-5); border-top: 1px solid var(--paper-2); }
  .card__cats { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-500); }
  .card__name { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: var(--step-2); line-height: 1; }
  .card__sub { font-size: 0.92rem; color: var(--ink-600); }
  .card__foot { display: flex; justify-content: space-between; align-items: center; gap: var(--sp-3); margin-top: var(--sp-3); }
  .card__price { font-family: var(--font-mono); font-weight: 500; color: var(--red-600); }
  .card__cta { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; font-size: 0.9rem; }
  .card__cta :global(svg) { width: 1rem; height: 1rem; transition: transform 0.3s var(--ease); }
  .card:hover .card__cta :global(svg) { transform: translateX(4px); }
</style>
