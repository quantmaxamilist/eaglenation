---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import type { LegalBlock } from '../data/legal';
interface Props { title: string; heading: string; description: string; blocks: LegalBlock[] }
const { title, heading, description, blocks } = Astro.props;
// Turn bare URLs and e-mail addresses in the legal text into links.
const linkify = (t: string) =>
  t
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" rel="noopener">$1</a>')
    .replace(/([\w.+-]+@[\w-]+(?:\.[\w-]+)+)/g, '<a href="mailto:$1">$1</a>')
    .replace(/\n/g, '<br />');
---
<Base title={title} description={description}>
  <PageHero title={heading} crumbs={[{ label: 'Home', href: '/' }, { label: heading }]} />
  <section class="section">
    <div class="container">
      <article class="legal prose">
        {blocks.map((b) =>
          b.t === 'h2' || b.t === 'h1' ? <h2 set:html={linkify(b.x)} /> :
          b.t === 'li' ? <p class="legal__li" set:html={linkify(b.x)} /> :
          <p set:html={linkify(b.x)} />
        )}
      </article>
    </div>
  </section>
</Base>
<style>
  .legal { max-width: 74ch; }
  .legal :global(h2) { font-size: var(--step-2); margin-top: 2.2em; line-height: 1.05; }
  .legal :global(h2:first-child) { margin-top: 0; }
  .legal :global(p) { color: var(--ink-700); }
  .legal :global(.legal__li) { position: relative; padding-left: 1.4rem; margin-top: 0.6em; }
  .legal :global(.legal__li)::before { content: ''; position: absolute; left: 0.2rem; top: 0.7em; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--red-600); }
  .legal :global(a) { overflow-wrap: anywhere; }
</style>
