---
import { nav, org } from '../data/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const menuItems = nav.filter((n) => n.href !== '/contact/');
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/" aria-label="Eagle Nation — home">
      <img src="/images/site/logo-colour-on-dark.png" alt="Eagle Nation" width="900" height="458" />
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul role="list">
        {menuItems.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__phone" href={org.phoneHref}><Icon name="phone" />{org.phoneDisplay}</a>
      <a class="btn site-header__cta" href="/contact/" aria-current={isActive('/contact/') ? 'page' : undefined}>Contact</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="visually-hidden">Menu</span>
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav class="container" aria-label="Mobile">
      <ul role="list">
        {nav.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="mobile-menu__num">0{i + 1}</span>{item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-menu__foot">
        <a href={org.phoneHref}><Icon name="phone" />{org.phoneDisplay}</a>
        <a href={`mailto:${org.email}`}><Icon name="mail" />{org.email}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 100;
    color: var(--white);
    transition: background-color 0.4s var(--ease), box-shadow 0.4s var(--ease), backdrop-filter 0.4s;
  }
  .site-header.is-scrolled {
    background: rgb(18 23 34 / 0.92);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.06), 0 10px 30px -18px rgb(0 0 0 / 0.6);
  }
  .site-header.menu-open { backdrop-filter: none; -webkit-backdrop-filter: none; background: var(--ink-950); box-shadow: none; }
  .site-header__inner {
    display: flex; align-items: center; gap: var(--sp-5);
    height: var(--header-h);
    transition: height 0.4s var(--ease);
  }
  .site-header.is-scrolled .site-header__inner { height: 72px; }
  .site-header__logo { flex: none; display: block; }
  .site-header__logo img { width: 138px; height: auto; transition: width 0.4s var(--ease); }
  .site-header.is-scrolled .site-header__logo img { width: 124px; }

  .site-nav { margin-left: auto; display: none; }
  .site-nav ul { display: flex; gap: clamp(0.9rem, 0.2rem + 1.4vw, 1.9rem); }
  .site-nav a {
    position: relative; display: inline-block; padding-block: 0.4rem;
    font-weight: 600; font-size: 0.97rem; text-decoration: none; color: rgb(255 255 255 / 0.82);
    transition: color 0.25s;
  }
  .site-nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; border-radius: 2px;
    background: var(--brand-gradient); transform: scaleX(0); transform-origin: left;
    transition: transform 0.4s var(--ease);
  }
  .site-nav a:hover, .site-nav a[aria-current='page'] { color: var(--white); }
  .site-nav a:hover::after, .site-nav a[aria-current='page']::after { transform: scaleX(1); }

  .site-header__actions { display: flex; align-items: center; gap: var(--sp-4); margin-left: auto; }
  .site-header__phone {
    display: none; align-items: center; gap: 0.45rem;
    font-family: var(--font-mono); font-size: 0.88rem; font-weight: 500; text-decoration: none; color: rgb(255 255 255 / 0.85);
  }
  .site-header__phone:hover { color: var(--white); }
  .site-header__phone :global(svg) { width: 1rem; height: 1rem; color: #ff8a8e; }
  .site-header__cta { min-height: 2.6rem; padding: 0.5rem 1.2rem; display: none; }
  .site-header__cta::after { background: var(--white) !important; }
  .site-header__cta:hover { color: var(--ink-900); border-color: var(--white); }

  .menu-toggle {
    display: grid; place-items: center; width: 2.9rem; height: 2.9rem; border-radius: 50%;
    background: rgb(255 255 255 / 0.08); border: 1px solid rgb(255 255 255 / 0.18); color: var(--white);
  }
  .menu-toggle__bars { display: grid; gap: 5px; width: 20px; }
  .menu-toggle__bars span { display: block; height: 2px; border-radius: 2px; background: currentColor; transition: transform 0.35s var(--ease), opacity 0.2s; }
  .menu-toggle__bars span:nth-child(3) { width: 65%; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:nth-child(3) { width: 100%; transform: translateY(-7px) rotate(-45deg); }

  .mobile-menu {
    position: fixed; inset: 0; z-index: -1; overflow-y: auto;
    background: var(--ink-950); padding-top: calc(var(--header-h) + 1.5rem); padding-bottom: 2rem;
    opacity: 0; transition: opacity 0.35s var(--ease);
  }
  .mobile-menu.is-open { opacity: 1; }
  .mobile-menu ul { display: grid; }
  .mobile-menu li {
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    opacity: 0; transform: translateY(14px);
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
    transition-delay: calc(var(--i) * 0.045s + 0.05s);
  }
  .mobile-menu.is-open li { opacity: 1; transform: none; }
  .mobile-menu li a {
    display: flex; align-items: baseline; gap: 1rem; padding: 1rem 0;
    font-family: var(--font-display); font-weight: 800; font-size: 2.3rem; line-height: 1; text-transform: uppercase;
    text-decoration: none; color: var(--paper);
  }
  .mobile-menu li a[aria-current='page'] { color: #ff8a8e; }
  .mobile-menu__num { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 500; color: var(--ink-400); }
  .mobile-menu__foot { display: grid; gap: 0.9rem; margin-top: 2rem; }
  .mobile-menu__foot a { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--ink-300); text-decoration: none; }
  .mobile-menu__foot :global(svg) { width: 1.1rem; height: 1.1rem; color: #ff8a8e; }

  @media (min-width: 560px) {
    .site-header__cta { display: inline-flex; }
  }
  @media (min-width: 1060px) {
    .site-nav { display: block; }
    .site-header__actions { margin-left: var(--sp-5); }
    .menu-toggle { display: none; }
    .site-header__logo img { width: 150px; }
  }
  @media (min-width: 1280px) {
    .site-header__phone { display: inline-flex; }
  }
</style>
